{
  "name": "myfi",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "start": "expo start --host lan --clear",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "phone": "expo start --host lan --clear",
    "phone:tunnel": "expo start --tunnel --clear",
    "smart:capture:serve": "npx supabase functions serve --no-verify-jwt",
    "smart:capture:deploy": "powershell -ExecutionPolicy Bypass -File tools/deploy-smart-capture.ps1",
    "smart:capture:deploy:ocr": "npx supabase functions deploy smart-ocr",
    "smart:capture:deploy:voice": "npx supabase functions deploy smart-transcribe",
    "test:logic": "node tests/run-financial-core.cjs",
    "test:sync-scenarios": "node tests/run-sync-scenarios.cjs",
    "test:db-schema": "node tests/db-schema.test.cjs",
    "test:backfill": "node tests/backfill-normalized.test.cjs",
    "test:ui": "node tests/ui-contract.test.cjs",
    "test:database": "npm run test:db-schema && npm run test:backfill && npm run test:logic",
    "test:gate": "node tests/run-quality-gate.cjs",
    "test:gate:static": "node tests/run-quality-gate.cjs --group=static",
    "test:gate:runtime": "node tests/run-quality-gate.cjs --group=runtime",
    "test:gate:cloud": "node tests/run-quality-gate.cjs --include-cloud",
    "test:gate:android": "node tests/run-quality-gate.cjs --include-android",
    "backfill:normalized": "node tools/backfill-normalized.cjs",
    "test:cloud": "node tests/run-cloud-integration.cjs",
    "test:sync:two-client": "node tests/run-financial-mutation-sync-e2e.cjs",
    "test:cloud:managed": "powershell -ExecutionPolicy Bypass -File tests/run-cloud-integration.ps1",
    "verify:android": "expo export --platform android --output-dir dist-android-verify --clear",
    "build:apk": "node -r ./tools/node-userinfo-fallback.cjs ./node_modules/eas-cli/bin/run build --platform android --profile preview",
    "build:aab": "node -r ./tools/node-userinfo-fallback.cjs ./node_modules/eas-cli/bin/run build --platform android --profile production"
  },
  "dependencies": {
    "@expo-google-fonts/cairo": "^0.4.2",
    "@expo/metro-runtime": "~6.1.2",
    "@expo/vector-icons": "^15.1.1",
    "@noble/ciphers": "^1.3.0",
    "@noble/hashes": "^1.8.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@supabase/supabase-js": "^2.105.3",
    "expo": "~54.0.36",
    "expo-asset": "~12.0.13",
    "expo-audio": "~1.1.1",
    "expo-clipboard": "~8.0.8",
    "expo-crypto": "~15.0.9",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-haptics": "~15.0.8",
    "expo-image-picker": "~17.0.11",
    "expo-local-authentication": "~17.0.8",
    "expo-notifications": "~0.32.17",
    "expo-print": "~15.0.8",
    "expo-screen-orientation": "~9.0.9",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-sqlite": "~16.0.10",
    "expo-status-bar": "~3.0.9",
    "expo-system-ui": "~6.0.9",
    "fflate": "^0.8.2",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.2",
    "zustand": "^5.0.0"
  },
  "private": true,
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@babel/plugin-transform-modules-commonjs": "7.29.7",
    "@types/react": "~19.1.10",
    "supabase": "^2.113.0",
    "typescript": "~5.9.2"
  },
  "expo": {
    "doctor": {
      "appConfigFieldsNotSyncedCheck": {
        "enabled": false
      }
    }
  }
}

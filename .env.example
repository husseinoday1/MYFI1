EXPO_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
EXPO_PUBLIC_SUPABASE_KEY=your_publishable_or_anon_key

# Normalized database reads: off (default), preview (manual), or shadow (compare after legacy sync).
# These modes are read-only and never replace the current legacy data path.
EXPO_PUBLIC_NORMALIZED_READ_MODE=off

# Optional manual overrides. Leave empty to use Supabase Edge Functions automatically.
EXPO_PUBLIC_OCR_URL=
EXPO_PUBLIC_TRANSCRIBE_URL=

# Product surface. All optional EXCEPT the privacy policy URL, which Google Play
# requires before a listing can be published. Any left empty simply hides its row in
# Settings; nothing breaks.
#
# The Legal & privacy group in Settings renders only when PRIVACY_URL or TERMS_URL is
# set, so leaving both empty hides that section entirely.
EXPO_PUBLIC_MAALFLOW_VERSION=1.0.0
EXPO_PUBLIC_MAALFLOW_PRIVACY_URL=
EXPO_PUBLIC_MAALFLOW_TERMS_URL=
EXPO_PUBLIC_MAALFLOW_SUPPORT_EMAIL=
EXPO_PUBLIC_MAALFLOW_SUPPORT_URL=
EXPO_PUBLIC_MAALFLOW_FEEDBACK_URL=
EXPO_PUBLIC_MAALFLOW_INSTAGRAM_URL=
EXPO_PUBLIC_MAALFLOW_FACEBOOK_URL=

{
  "expo": {
    "name": "MaalFlow",
    "slug": "maalflow",
    "scheme": "maalflow",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "orientation": "default",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/maalflow-app-icon-v2.png",
    "splash": {
      "image": "./assets/maalflow-splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#0D1110"
    },
    "android": {
      "allowBackup": false,
      "versionCode": 2,
      "adaptiveIcon": {
        "foregroundImage": "./assets/maalflow-app-icon-v2.png",
        "backgroundColor": "#111713"
      },
      "package": "com.maalflow.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.maalflow.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-notifications",
      "expo-document-picker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يستخدم MaalFlow بصمتك أو رمز جهازك لقفل التطبيق وحماية بياناتك المالية."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج MaalFlow الوصول للصور حتى تختار فاتورة وتحوّلها إلى عملية مالية.",
          "cameraPermission": "يحتاج MaalFlow استخدام الكاميرا لتصوير الفواتير."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "يحتاج MaalFlow استخدام المايكروفون لتسجيل العملية صوتياً.",
          "enableBackgroundRecording": false
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "aa300f05-4371-49cb-91d1-026d1eef07f6"
      }
    },
    "owner": "husseinoday1"
  }
}

{
  "expo": {
    "name": "MYFI",
    "slug": "terra-finance",
    "version": "1.0.0",
    "platforms": [
      "android",
      "ios",
      "web"
    ],
    "orientation": "portrait",
    "icon": "./assets/myfi-app-icon.png",
    "splash": {
      "image": "./assets/myfi-splash-logo.png",
      "resizeMode": "contain",
      "backgroundColor": "#031D2A"
    },
    "android": {
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/myfi-adaptive-foreground.png",
        "backgroundColor": "#031D2A"
      },
      "package": "com.myfi.app",
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT",
        "android.permission.RECORD_AUDIO",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.myfi.app",
      "supportsTablet": false
    },
    "plugins": [
      "expo-notifications",
      "expo-document-picker",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "يستخدم MYFI بصمتك أو رمز جهازك لقفل التطبيق وحماية بياناتك المالية."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "يحتاج MYFI الوصول للصور حتى تختار فاتورة وتحوّلها إلى عملية مالية.",
          "cameraPermission": "يحتاج MYFI استخدام الكاميرا لتصوير الفواتير."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "يحتاج MYFI استخدام المايكروفون لتسجيل العملية صوتياً.",
          "enableBackgroundRecording": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "يستخدم MYFI موقعك مرة واحدة لاقتراح الدولة والعملة، ويمكنك تغييرهما يدويًا."
        }
      ],
      "expo-asset"
    ],
    "extra": {
      "eas": {
        "projectId": "aa300f05-4371-49cb-91d1-026d1eef07f6"
      }
    },
    "owner": "husseinoday1"
  }
}

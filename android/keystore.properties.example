# §106 production signing -- local, per-machine file. Copy this to
# `keystore.properties` (same folder, no `.example`) and fill in your own values.
# `keystore.properties` is git-ignored; it must never be committed.
#
# storeFile: the ABSOLUTE path to maalflow-upload.keystore. Using an absolute path
# avoids any ambiguity about which directory a relative path would be resolved from.
# On Windows, forward slashes work fine inside this file, e.g.:
#   storeFile=C:/Users/husse/OneDrive/Документы/MYFI/maalflow-upload.keystore
#
# storePassword / keyPassword: whatever you entered when you ran `keytool -genkeypair`.
# If you pressed Enter at the "key password" prompt, both values are identical.
#
# keyAlias: whatever you passed to `-alias` when generating the keystore.
# The MAALFLOW_LAUNCH_RUNBOOK_AR.md command used `-alias maalflow-upload`.

storeFile=C:/absolute/path/to/maalflow-upload.keystore
storePassword=CHANGE_ME
keyAlias=maalflow-upload
keyPassword=CHANGE_ME
